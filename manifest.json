{
    "manifest_version": 3,
    "name": "YouTube, LinkedIn and Reddit Ad Blocker",
    "version":"1.0",
    "description":"Blocks ads on Youtube, LinkedIn and Reddit",
    "permissions":[
        "webRequest",
        "activeTab",
        "storage",
        "declarativeNetRequest"
    ],
    "host_permissions":[
        "https://www.youtube.com/*",
        "https://www.linkedin.com/*",
        "https://*.reddit.com/*"
    ],
    "background":{
        "service_worker":"background.js"
    },
    
    "content_scripts":[
        {
            "matches":[
                "https://*.youtube.com/*",
                "https://*.linkedin.com/*",
                "https://*.reddit.com/*"
            ],
            "js":["content.js"]
        }
    ],
    "action":{
        "default_popup":"popup.html",
        "default_icon":{
            "16": "icons/icon-64.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    }
}
